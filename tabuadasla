using System;

namespace TabuadaApp
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Tabuada do 5:");
            Console.WriteLine("-------------");

            // O laço 'for' começa em 1 e vai até 10
            for (int i = 1; i <= 10; i++)
            {
                int resultado = 5 * i;
                Console.WriteLine($"5 x {i} = {resultado}");
            }

            // Mantém o console aberto até que uma tecla seja pressionada
            Console.ReadKey();
        }
    }
}

