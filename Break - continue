using System;

class Program
{
    static void Main()
    {
        for (int i = 1; i <= 10; i++)
        {
            if (i == 5)
            {
                continue; // Pula o resto do código nesta iteração e vai para o próximo número
            }

            if (i == 8)
            {
                break; // Encerra o loop completamente
            }

            Console.WriteLine(i);
        }
    }
}
